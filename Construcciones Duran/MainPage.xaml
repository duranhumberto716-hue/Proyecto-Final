<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Proyecto_Final.ViewModels"
             xmlns:models="clr-namespace:Proyecto_Final.Models"
             x:Class="Proyecto_Final.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="{StaticResource FondoApp}"
             Title="Catálogo de obras"
             Shell.NavBarIsVisible="True">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="22" Padding="20,20,20,96" MaximumWidthRequest="1000">

                <!-- 1. ENCABEZADO CORPORATIVO MINIMALISTA -->
                <Border Style="{StaticResource Tarjeta}" Stroke="{StaticResource BrochaAcento}" Padding="20">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border StrokeShape="RoundRectangle 14" Stroke="{StaticResource BrochaBorde}" StrokeThickness="1"
                                    BackgroundColor="#08142C" Padding="6" WidthRequest="68" HeightRequest="68" VerticalOptions="Center">
                                <Image Source="logo_construcciones_duran.png" Aspect="AspectFit"
                                       SemanticProperties.Description="Logo Oficial Construcciones Durán" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="CONSTRUCCIONES DURÁN" Style="{StaticResource SubtituloSeccion}" />
                                <Label Text="Solidez, calidad y compromiso" FontSize="19" FontAttributes="Bold"
                                       TextColor="{StaticResource TextoClaro}" />
                                <Label Text="Cel: 77661522 • Garantía estructural • Llave en mano"
                                       Style="{StaticResource TextoDetalle}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Cotizar proyecto" Command="{Binding NavegarACotizarCommand}"
                                    Style="{StaticResource BotonPrimario}" />
                            <Button Grid.Column="1" Text="Pedir información" Command="{Binding ContactarWhatsAppDirectoCommand}"
                                    Style="{StaticResource BotonWhatsApp}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 2. PORTAFOLIO DE OBRAS REALIZADAS -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="PORTAFOLIO EN LA NUBE" Style="{StaticResource SubtituloSeccion}" />
                            <Label Text="Obras realizadas" Style="{StaticResource TituloSeccion}" FontSize="19" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Cotizar" Command="{Binding NavegarACotizarCommand}"
                                Style="{StaticResource BotonPildoraSuave}" VerticalOptions="Center" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Proyectos}"
                                    ItemsLayout="HorizontalList"
                                    HeightRequest="330"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="20">
                                <ActivityIndicator IsRunning="True" Color="{StaticResource Acento}" />
                                <Label Text="Cargando obras..." Style="{StaticResource TextoDetalle}" Margin="0,8,0,0" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Proyecto">
                                <Border WidthRequest="290" Margin="0,0,12,0" Style="{StaticResource TarjetaMinimal}" Padding="0">
                                    <Grid RowDefinitions="160,Auto,Auto,Auto" RowSpacing="6">
                                        <Image Grid.Row="0" Source="{Binding ImagenUrl}" Aspect="AspectFill" HeightRequest="160" />

                                        <HorizontalStackLayout Grid.Row="1" Spacing="8" Margin="12,8,12,0">
                                            <Border BackgroundColor="{StaticResource FondoTarjetaSuave}"
                                                    Stroke="{StaticResource BrochaBorde}" StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 6" Padding="7,2">
                                                <Label Text="{Binding Categoria}" FontSize="10" FontAttributes="Bold"
                                                       TextColor="{StaticResource Acento}" />
                                            </Border>
                                            <Label Text="{Binding BadgeTexto}" FontSize="11"
                                                   TextColor="{StaticResource TextoSuave}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <Label Grid.Row="2" Text="{Binding Titulo}" Margin="12,0"
                                               FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextoClaro}"
                                               LineBreakMode="TailTruncation" />

                                        <VerticalStackLayout Grid.Row="3" Spacing="2" Margin="12,0,12,12">
                                            <Label Text="{Binding Ubicacion, StringFormat='Ubicación: {0}'}"
                                                   FontSize="11" TextColor="{StaticResource Acento}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Descripcion}" Style="{StaticResource TextoDetalle}"
                                                   MaxLines="2" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- 3. SERVICIOS ESPECIALIZADOS -->
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="SERVICIOS EMPRESARIALES" Style="{StaticResource SubtituloSeccion}" />
                        <Label Text="¿Qué construimos para ti?" Style="{StaticResource TituloSeccion}" FontSize="19" />
                    </VerticalStackLayout>

                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10">
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TarjetaMinimal}">
                            <VerticalStackLayout Spacing="6">
                                <Border Style="{StaticResource CajaIcono}" HorizontalOptions="Start" WidthRequest="38" HeightRequest="38">
                                    <Path Data="M12,7 V3 H2 V21 H22 V7 H12 Z M6,19 H4 V17 H6 V19 Z M6,15 H4 V13 H6 V15 Z M6,11 H4 V9 H6 V11 Z M6,7 H4 V5 H6 V7 Z M20,19 H12 V17 H14 V15 H12 V13 H14 V11 H12 V9 H20 V19 Z"
                                          Fill="{StaticResource Acento}" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="Edificación Civil" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextoClaro}" />
                                <Label Text="Construcción desde cero de viviendas, condominios y locales comerciales." Style="{StaticResource TextoDetalle}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource TarjetaMinimal}">
                            <VerticalStackLayout Spacing="6">
                                <Border Style="{StaticResource CajaIcono}" HorizontalOptions="Start" WidthRequest="38" HeightRequest="38">
                                    <Path Data="M22.7,19 L13.6,9.9 C14.5,7.6 14,4.9 12.1,3 C10.1,1 7.1,0.6 4.7,1.7 L9,6 L6,9 L1.6,4.7 C0.4,7.1 0.9,10.1 2.9,12.1 C4.8,14 7.5,14.5 9.8,13.6 L18.9,22.7 C19.3,23.1 19.9,23.1 20.3,22.7 L22.6,20.4 C23.1,20 23.1,19.3 22.7,19 Z"
                                          Fill="{StaticResource Acento}" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="Obra Gruesa" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextoClaro}" />
                                <Label Text="Fundaciones, losas alivianadas, muros de contención y columnas armadas." Style="{StaticResource TextoDetalle}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource TarjetaMinimal}">
                            <VerticalStackLayout Spacing="6">
                                <Border Style="{StaticResource CajaIcono}" HorizontalOptions="Start" WidthRequest="38" HeightRequest="38">
                                    <Path Data="M7,14 C5.34,14 4,15.34 4,17 C4,18.31 2.84,19 2,19 C2.92,20.22 4.49,21 6,21 C8.21,21 10,19.21 10,17 C10,15.34 8.66,14 7,14 Z M20.71,4.63 L19.37,3.29 C18.98,2.9 18.35,2.9 17.96,3.29 L9,12.25 L11.75,15 L20.71,6.04 C21.1,5.65 21.1,5.02 20.71,4.63 Z"
                                          Fill="{StaticResource Acento}" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="Remodelaciones" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextoClaro}" />
                                <Label Text="Renovación integral de fachadas, pisos de porcelanato y cielos falsos." Style="{StaticResource TextoDetalle}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TarjetaMinimal}">
                            <VerticalStackLayout Spacing="6">
                                <Border Style="{StaticResource CajaIcono}" HorizontalOptions="Start" WidthRequest="38" HeightRequest="38">
                                    <Path Data="M3,17.25 V21 H6.75 L17.81,9.94 L14.06,6.19 L3,17.25 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 L20.71,7.04 Z"
                                          Fill="{StaticResource Acento}" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="Planos y Asesoría" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextoClaro}" />
                                <Label Text="Cálculo de presupuestos, cómputos métricos y dirección técnica de obra." Style="{StaticResource TextoDetalle}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- 4. GARANTÍA Y CONFIANZA -->
                <Border Style="{StaticResource TarjetaMinimal}" Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="GARANTÍA Y CONFIANZA" Style="{StaticResource SubtituloSeccion}" />
                        <Label Text="¿Por qué construir con nosotros?" Style="{StaticResource TituloSeccion}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Style="{StaticResource CajaIcono}" WidthRequest="34" HeightRequest="34">
                                <Path Data="M12,17.27 L18.18,21 L16.54,13.97 L22,9.24 L14.81,8.63 L12,2 L9.19,8.63 L2,9.24 L7.46,13.97 L5.82,21 L12,17.27 Z"
                                      Fill="{StaticResource Acento}" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="+15 Años de Experiencia" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextoClaro}" />
                                <Label Text="Trayectoria sólida ejecutando proyectos residenciales y comerciales." Style="{StaticResource TextoDetalle}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Style="{StaticResource CajaIcono}" WidthRequest="34" HeightRequest="34">
                                <Path Data="M12,1 L3,5 V11 C3,16.55 6.84,21.74 12,23 C17.16,21.74 21,16.55 21,11 V5 L12,1 Z M10,17 L6,13 L7.41,11.59 L10,14.17 L16.59,7.58 L18,9 L10,17 Z"
                                      Fill="{StaticResource Acento}" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Materiales Certificados y Garantía" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextoClaro}" />
                                <Label Text="Proveedores líderes y ensayos de calidad de hormigón." Style="{StaticResource TextoDetalle}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Style="{StaticResource CajaIcono}" WidthRequest="34" HeightRequest="34">
                                <Path Data="M11.99,2 C6.47,2 2,6.48 2,12 C2,17.52 6.47,22 11.99,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 11.99,2 Z M12,20 C7.58,20 4,16.42 4,12 C4,7.58 7.58,4 12,4 C16.42,4 20,7.58 20,12 C20,16.42 16.42,20 12,20 Z M12.5,7 H11 V13 L16.25,16.15 L17,14.92 L12.5,12.25 V7 Z"
                                      Fill="{StaticResource Acento}" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Cumplimiento de Plazos" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextoClaro}" />
                                <Label Text="Cronograma de obra claro y seguimiento continuo." Style="{StaticResource TextoDetalle}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- PIE -->
                <Label Text="Construcciones Durán © 2026 • Cel: 77661522 • Santa Cruz, Bolivia"
                       Style="{StaticResource TextoDetalle}" HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTÓN FLOTANTE WHATSAPP -->
        <Border HorizontalOptions="End" VerticalOptions="End" Margin="0,0,20,24"
                WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 28"
                StrokeThickness="0" BackgroundColor="Transparent">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ContactarWhatsAppDirectoCommand}" />
            </Border.GestureRecognizers>
            <Image Source="ic_whatsapp.png" WidthRequest="56" HeightRequest="56" Aspect="AspectFit" />
        </Border>

        <Grid BackgroundColor="#99060F24" IsVisible="{Binding IsBusy}" InputTransparent="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Acento}" />
                <Label Text="Cargando..." Style="{StaticResource TextoDetalle}" TextColor="{StaticResource TextoClaro}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
