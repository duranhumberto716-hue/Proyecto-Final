<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Proyecto_Final.ViewModels"
             x:Class="Proyecto_Final.CotizacionPage"
             x:DataType="vm:CotizacionViewModel"
             BackgroundColor="#07122A"
             Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="16,20,16,40">

                <!-- 1. BARRA SUPERIOR CON BOTÓN VOLVER Y TÍTULO -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Button Grid.Column="0"
                            Text="⬅ Volver"
                            Command="{Binding VolverCommand}"
                            BackgroundColor="#1E3A6E"
                            TextColor="#FFFFFF"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="12"
                            HeightRequest="42"
                            Padding="14,0" />

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="COTIZADOR DE OBRAS"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#FFDE00" />
                        <Label Text="Construcciones Durán • Cel: 77661522"
                               FontSize="11"
                               TextColor="#94A3B8" />
                    </VerticalStackLayout>
                </Grid>

                <!-- 2. FORMULARIO PRINCIPAL DE COTIZACIÓN -->
                <Border StrokeShape="RoundRectangle 22"
                        Stroke="#FFDE00"
                        StrokeThickness="1.5"
                        BackgroundColor="#0B1B3D"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,6" Radius="10" Opacity="0.35" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="📋" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout>
                                <Label Text="Solicitud de Presupuesto"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF" />
                                <Label Text="Completa los datos para calcular un estimado"
                                       FontSize="11"
                                       TextColor="#CBD5E1" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1" Color="#1E3A6E" />

                        <!-- Nombre -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Nombre completo del cliente *" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Border StrokeShape="RoundRectangle 10" Stroke="#2D4A7D" BackgroundColor="#07122A" Padding="12,2">
                                <Entry Text="{Binding Nombre}"
                                       Placeholder="Ej. Arq. Carlos Mendoza"
                                       PlaceholderColor="#64748B"
                                       TextColor="#FFFFFF" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Teléfono -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Teléfono de contacto (Opcional)" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Border StrokeShape="RoundRectangle 10" Stroke="#2D4A7D" BackgroundColor="#07122A" Padding="12,2">
                                <Entry Text="{Binding Telefono}"
                                       Keyboard="Telephone"
                                       Placeholder="Ej. 77661522"
                                       PlaceholderColor="#64748B"
                                       TextColor="#FFFFFF" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Tipo de Proyecto -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Tipo de obra o proyecto *" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Border StrokeShape="RoundRectangle 10" Stroke="#2D4A7D" BackgroundColor="#07122A" Padding="12,0">
                                <Picker ItemsSource="{Binding TiposProyecto}"
                                        SelectedItem="{Binding TipoProyectoSeleccionado}"
                                        Title="Selecciona el tipo de trabajo"
                                        TitleColor="#64748B"
                                        TextColor="#FFFFFF" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Metros cuadrados m² -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Área aproximada en m² *" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Border StrokeShape="RoundRectangle 10" Stroke="#2D4A7D" BackgroundColor="#07122A" Padding="12,2">
                                <Entry Text="{Binding MetrosCuadradosTexto}"
                                       Keyboard="Numeric"
                                       Placeholder="Ej. 180"
                                       PlaceholderColor="#64748B"
                                       TextColor="#FFFFFF" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Ubicación -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Ubicación o zona de la obra *" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Border StrokeShape="RoundRectangle 10" Stroke="#2D4A7D" BackgroundColor="#07122A" Padding="12,2">
                                <Entry Text="{Binding Ubicacion}"
                                       Placeholder="Ej. Santa Cruz, Barrio Equipetrol"
                                       PlaceholderColor="#64748B"
                                       TextColor="#FFFFFF" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Detalles / Observaciones -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Detalles del proyecto o requerimientos especiales" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Border StrokeShape="RoundRectangle 10" Stroke="#2D4A7D" BackgroundColor="#07122A" Padding="12,8">
                                <Editor Text="{Binding Descripcion}"
                                        HeightRequest="85"
                                        Placeholder="Describe ideas, planos aprobados, materiales de preferencia, fecha tentativa, etc."
                                        PlaceholderColor="#64748B"
                                        TextColor="#FFFFFF"
                                        AutoSize="Disabled" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Caja de Estimado Referencial Dinámico -->
                        <Border StrokeShape="RoundRectangle 14"
                                Stroke="#FFDE00"
                                StrokeDashArray="4,2"
                                BackgroundColor="#06142E"
                                Padding="16">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="PRESUPUESTO ESTIMADO REFERENCIAL:"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#FFDE00" />
                                <Label Text="{Binding EstimadoReferencialFormateado}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF" />
                                <Label Text="* Monto promedio preliminar en USD. El presupuesto final oficial se define tras inspección en terreno."
                                       FontSize="10"
                                       TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Botón de Envío por WhatsApp -->
                        <Button Text="📲 Enviar Cotización por WhatsApp"
                                Command="{Binding EnviarCotizacionCommand}"
                                BackgroundColor="#25D366"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="15"
                                CornerRadius="12"
                                HeightRequest="52"
                                Margin="0,8,0,0" />

                        <Label Text="Se abrirá WhatsApp prellenando el mensaje con todos tus datos estructurados para el contratista."
                               FontSize="11"
                               TextColor="#94A3B8"
                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Indicador de Carga -->
        <Grid BackgroundColor="#9907122A"
              IsVisible="{Binding IsBusy}"
              InputTransparent="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#FFDE00" />
                <Label Text="Conectando con WhatsApp..." TextColor="#FFFFFF" FontSize="13" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>

