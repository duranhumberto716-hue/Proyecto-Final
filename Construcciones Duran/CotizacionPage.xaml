<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Proyecto_Final.ViewModels"
             x:Class="Proyecto_Final.CotizacionPage"
             x:DataType="vm:CotizacionViewModel"
             Title="Cotizar obra"
             BackgroundColor="{StaticResource FondoApp}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="18" Padding="20,20,20,36" MaximumWidthRequest="680">

                <!-- ENCABEZADO MINIMALISTA -->
                <VerticalStackLayout Spacing="3">
                    <Label Text="COTIZADOR DE OBRAS" Style="{StaticResource SubtituloSeccion}" />
                    <Label Text="Solicitud de presupuesto" Style="{StaticResource TituloPagina}" />
                    <Label Text="Completa los datos de tu proyecto para calcular un estimado en USD y enviarlo por WhatsApp."
                           Style="{StaticResource TextoDetalle}" />
                </VerticalStackLayout>

                <!-- FORMULARIO UNIFICADO -->
                <Border Style="{StaticResource Tarjeta}" Padding="20">
                    <VerticalStackLayout Spacing="14">

                        <!-- Nombre y Teléfono -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Nombre completo *" Style="{StaticResource Etiqueta}" />
                                <Border Style="{StaticResource CajaCampo}">
                                    <Entry Text="{Binding Nombre}" Placeholder="Ej: Carlos Mendoza"
                                           Style="{StaticResource CampoSinFondo}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Teléfono (opcional)" Style="{StaticResource Etiqueta}" />
                                <Border Style="{StaticResource CajaCampo}">
                                    <Entry Text="{Binding Telefono}" Keyboard="Telephone" MaxLength="8"
                                           Placeholder="Ej: 77661522" Style="{StaticResource CampoSinFondo}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Tipo de Proyecto y Área -->
                        <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Tipo de obra *" Style="{StaticResource Etiqueta}" />
                                <Border Style="{StaticResource CajaCampo}">
                                    <Picker ItemsSource="{Binding TiposProyecto}"
                                            SelectedItem="{Binding TipoProyectoSeleccionado}"
                                            Title="Selecciona el tipo de trabajo"
                                            Style="{StaticResource SelectorSinFondo}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Área (m²) *" Style="{StaticResource Etiqueta}" />
                                <Border Style="{StaticResource CajaCampo}">
                                    <Entry Text="{Binding MetrosCuadradosTexto}" Keyboard="Numeric"
                                           Placeholder="Ej: 180" Style="{StaticResource CampoSinFondo}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Ubicación -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Ubicación o zona de la obra *" Style="{StaticResource Etiqueta}" />
                            <Border Style="{StaticResource CajaCampo}">
                                <Entry Text="{Binding Ubicacion}" Placeholder="Ej: Santa Cruz, Barrio Equipetrol"
                                       Style="{StaticResource CampoSinFondo}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Detalles -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Detalles y requerimientos especiales" Style="{StaticResource Etiqueta}" />
                            <Border Style="{StaticResource CajaEditor}">
                                <Editor Text="{Binding Descripcion}" HeightRequest="84" AutoSize="Disabled"
                                        Placeholder="Planos aprobados, materiales de preferencia, fecha tentativa..."
                                        Style="{StaticResource EditorSinFondo}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Estimado Referencial -->
                        <Border Style="{StaticResource TarjetaMinimal}" Stroke="{StaticResource BrochaAcento}"
                                BackgroundColor="{StaticResource FondoApp}" Padding="16">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="PRESUPUESTO ESTIMADO REFERENCIAL" Style="{StaticResource SubtituloSeccion}" />
                                <Label Text="{Binding EstimadoReferencialFormateado}" FontSize="20" FontAttributes="Bold"
                                       TextColor="{StaticResource TextoClaro}" />
                                <Label Text="Monto promedio preliminar en USD. El presupuesto final se define tras inspección técnica."
                                       Style="{StaticResource TextoDetalle}" FontSize="11" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Acciones -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button Grid.Column="0" Text="Enviar por WhatsApp"
                                    Command="{Binding EnviarCotizacionCommand}"
                                    Style="{StaticResource BotonWhatsApp}" />
                            <Button Grid.Column="1" Text="Volver"
                                    Command="{Binding VolverCommand}"
                                    Style="{StaticResource BotonSecundario}" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Grid BackgroundColor="#99060F24" IsVisible="{Binding IsBusy}" InputTransparent="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Acento}" />
                <Label Text="Conectando con WhatsApp..." Style="{StaticResource TextoDetalle}" TextColor="{StaticResource TextoClaro}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
