<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Proyecto_Final.ViewModels"
             xmlns:models="clr-namespace:Proyecto_Final.Models"
             x:Class="Proyecto_Final.Views.MaterialesPage"
             x:Name="Pagina"
             x:DataType="vm:MaterialesViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource FondoApp}">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,36" Spacing="16" MaximumWidthRequest="1160">

            <!-- ENCABEZADO MINIMALISTA -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="3">
                    <Label Text="GESTIÓN DE DATOS • INTEGRANTE 3" Style="{StaticResource SubtituloSeccion}" />
                    <Label Text="CRUD de Materiales" Style="{StaticResource TituloPagina}" />
                    <Label Text="{Binding TotalRegistros, StringFormat='Base de datos SQLite • {0} registro(s)'}"
                           Style="{StaticResource TextoDetalle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Ver reporte" Command="{Binding VerReporteCommand}"
                        Style="{StaticResource BotonAccion}" VerticalOptions="Center" />
            </Grid>

            <BoxView HeightRequest="1" Color="{StaticResource BordeTarjeta}" Opacity="0.6" />

            <!-- FORMULARIO DESPLEGABLE UNIFICADO (Agregar / Editar) -->
            <Border Style="{StaticResource Tarjeta}" Stroke="{StaticResource BrochaAcento}" StrokeThickness="1.5"
                    MaximumWidthRequest="760" IsVisible="{Binding FormularioVisible}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding TituloFormulario}" Style="{StaticResource TituloSeccion}" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nombre del material *" Style="{StaticResource Etiqueta}" />
                        <Border Style="{StaticResource CajaCampo}">
                            <Entry Text="{Binding Actual.Nombre}" Placeholder="Ej: Cemento Portland IP-30"
                                   Style="{StaticResource CampoSinFondo}" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Categoría *" Style="{StaticResource Etiqueta}" />
                            <Border Style="{StaticResource CajaCampo}">
                                <Picker ItemsSource="{Binding Categorias}" SelectedItem="{Binding Actual.Categoria}"
                                        Title="Seleccione" Style="{StaticResource SelectorSinFondo}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Unidad *" Style="{StaticResource Etiqueta}" />
                            <Border Style="{StaticResource CajaCampo}">
                                <Picker ItemsSource="{Binding Unidades}" SelectedItem="{Binding Actual.Unidad}"
                                        Title="Seleccione" Style="{StaticResource SelectorSinFondo}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Cantidad *" Style="{StaticResource Etiqueta}" />
                            <Border Style="{StaticResource CajaCampo}">
                                <Entry Text="{Binding Actual.Cantidad}" Keyboard="Numeric"
                                       Style="{StaticResource CampoSinFondo}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Precio (Bs) *" Style="{StaticResource Etiqueta}" />
                            <Border Style="{StaticResource CajaCampo}">
                                <Entry Text="{Binding Actual.PrecioUnitario}" Keyboard="Numeric"
                                       Style="{StaticResource CampoSinFondo}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="6">
                            <Label Text="Stock mínimo" Style="{StaticResource Etiqueta}" />
                            <Border Style="{StaticResource CajaCampo}">
                                <Entry Text="{Binding Actual.StockMinimo}" Keyboard="Numeric"
                                       Style="{StaticResource CampoSinFondo}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Use punto (.) para decimales. Ej: 1.50" Style="{StaticResource TextoDetalle}" FontSize="11" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                        <Button Text="{Binding TextoBotonGuardar}" Command="{Binding GuardarCommand}" Style="{StaticResource BotonPrimario}" />
                        <Button Grid.Column="1" Text="Cancelar" Command="{Binding CancelarCommand}" Style="{StaticResource BotonSecundario}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- BUSCADOR MINIMALISTA -->
            <Border Style="{StaticResource CajaCampo}" MaximumWidthRequest="460" HorizontalOptions="Start">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Path Data="M15.5,14 H14.71 L14.43,13.73 C15.41,12.59 16,11.11 16,9.5 C16,5.91 13.09,3 9.5,3 C5.91,3 3,5.91 3,9.5 C3,13.09 5.91,16 9.5,16 C11.11,16 12.59,15.41 13.73,14.43 L14,14.71 V15.5 L19,20.49 L20.49,19 L15.5,14 Z M9.5,14 C7.01,14 5,11.99 5,9.5 C5,7.01 7.01,5 9.5,5 C11.99,5 14,7.01 14,9.5 C14,11.99 11.99,14 9.5,14 Z"
                          Fill="{StaticResource TextoSecundario}" WidthRequest="18" HeightRequest="18"
                          Aspect="Uniform" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Text="{Binding Busqueda}"
                           Placeholder="Buscar por material o categoría..."
                           Style="{StaticResource CampoSinFondo}" />
                </Grid>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Acento}" />

            <!-- TABLA CRUD -->
            <Border Style="{StaticResource ContenedorTabla}">
                <ScrollView Orientation="Horizontal">
                    <VerticalStackLayout Spacing="0">
                        <Grid BackgroundColor="{StaticResource FondoEncabezadoTabla}"
                              Padding="14,12" ColumnSpacing="12"
                              ColumnDefinitions="45,190,155,75,80,95,75,105,100,145">
                            <Label Grid.Column="0" Text="ID" Style="{StaticResource EncabezadoTabla}" />
                            <Label Grid.Column="1" Text="Material" Style="{StaticResource EncabezadoTabla}" />
                            <Label Grid.Column="2" Text="Categoría" Style="{StaticResource EncabezadoTabla}" />
                            <Label Grid.Column="3" Text="Unidad" Style="{StaticResource EncabezadoTabla}" />
                            <Label Grid.Column="4" Text="Cant." Style="{StaticResource EncabezadoTabla}" />
                            <Label Grid.Column="5" Text="Precio" Style="{StaticResource EncabezadoTabla}" />
                            <Label Grid.Column="6" Text="Mínimo" Style="{StaticResource EncabezadoTabla}" />
                            <Label Grid.Column="7" Text="Valor Total" Style="{StaticResource EncabezadoTabla}" />
                            <Label Grid.Column="8" Text="Estado" Style="{StaticResource EncabezadoTabla}" />
                            <Label Grid.Column="9" Text="Acciones" Style="{StaticResource EncabezadoTabla}" />
                        </Grid>
                        <BoxView HeightRequest="1.5" Color="{StaticResource Acento}" />

                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Items}">
                            <BindableLayout.EmptyView>
                                <Label Text="No hay materiales registrados para mostrar." Style="{StaticResource TextoDetalle}"
                                       Padding="16,24" HorizontalTextAlignment="Start" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Material">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid Padding="14,10" ColumnSpacing="12"
                                              BackgroundColor="{StaticResource FondoTarjeta}"
                                              ColumnDefinitions="45,190,155,75,80,95,75,105,100,145">
                                            <Grid.Triggers>
                                                <DataTrigger TargetType="Grid" Binding="{Binding EsFilaAlterna}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource FondoFilaAlterna}" />
                                                </DataTrigger>
                                            </Grid.Triggers>

                                            <Label Grid.Column="0" Text="{Binding Id}" Style="{StaticResource CeldaId}" />
                                            <Label Grid.Column="1" Text="{Binding Nombre}" Style="{StaticResource CeldaTexto}" FontAttributes="Bold" />
                                            <Label Grid.Column="2" Text="{Binding Categoria}" Style="{StaticResource CeldaSecundaria}" />
                                            <Label Grid.Column="3" Text="{Binding Unidad}" Style="{StaticResource CeldaSecundaria}" />
                                            <Label Grid.Column="4" Text="{Binding Cantidad, StringFormat='{0:N0}'}" Style="{StaticResource CeldaTexto}" />
                                            <Label Grid.Column="5" Text="{Binding PrecioUnitario, StringFormat='Bs {0:N2}'}" Style="{StaticResource CeldaSecundaria}" />
                                            <Label Grid.Column="6" Text="{Binding StockMinimo, StringFormat='{0:N0}'}" Style="{StaticResource CeldaSecundaria}" />
                                            <Label Grid.Column="7" Text="{Binding ValorTotal, StringFormat='Bs {0:N2}'}" Style="{StaticResource CeldaTexto}" />
                                            <Border Grid.Column="8" BackgroundColor="{StaticResource Exito}"
                                                    StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="8,4"
                                                    VerticalOptions="Center" HorizontalOptions="Start">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding StockBajo}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Alerta}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding EstadoStock}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                                            </Border>
                                            <HorizontalStackLayout Grid.Column="9" Spacing="6" VerticalOptions="Center">
                                                <Button Text="Editar" Style="{StaticResource BotonEditarTabla}"
                                                        Command="{Binding Source={x:Reference Pagina}, Path=BindingContext.EditarCommand, x:DataType={x:Null}}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Text="Borrar" Style="{StaticResource BotonEliminarTabla}"
                                                        Command="{Binding Source={x:Reference Pagina}, Path=BindingContext.EliminarCommand, x:DataType={x:Null}}"
                                                        CommandParameter="{Binding .}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{StaticResource BordeTarjeta}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- BARRA INFERIOR DE ACCIONES -->
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center">
                <Button Text="Exportar CSV" Command="{Binding ExportarCsvCommand}"
                        Style="{StaticResource BotonCsv}" Margin="0,0,10,8" />
                <Button Text="Agregar Material" Command="{Binding NuevoCommand}"
                        Style="{StaticResource BotonAgregar}" Margin="0,0,10,8" />
            </FlexLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
