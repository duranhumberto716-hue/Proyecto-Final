<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Proyecto_Final.ViewModels"
             xmlns:models="clr-namespace:Proyecto_Final.Models"
             x:Class="Proyecto_Final.Views.MaterialesPage"
             x:DataType="vm:MaterialesViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource FondoApp}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- FORMULARIO (Crear / Editar) -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding TituloFormulario}" Style="{StaticResource TituloSeccion}" />

                    <Label Text="Nombre del material *" Style="{StaticResource Etiqueta}" />
                    <Entry Text="{Binding Actual.Nombre}" Placeholder="Ej: Cemento Portland IP-30" Style="{StaticResource Campo}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Categoría *" Style="{StaticResource Etiqueta}" />
                            <Picker ItemsSource="{Binding Categorias}" SelectedItem="{Binding Actual.Categoria}"
                                    Title="Seleccione" Style="{StaticResource Selector}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Unidad *" Style="{StaticResource Etiqueta}" />
                            <Picker ItemsSource="{Binding Unidades}" SelectedItem="{Binding Actual.Unidad}"
                                    Title="Seleccione" Style="{StaticResource Selector}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Cantidad *" Style="{StaticResource Etiqueta}" />
                            <Entry Text="{Binding Actual.Cantidad}" Keyboard="Numeric" Style="{StaticResource Campo}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Precio (Bs) *" Style="{StaticResource Etiqueta}" />
                            <Entry Text="{Binding Actual.PrecioUnitario}" Keyboard="Numeric" Style="{StaticResource Campo}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="6">
                            <Label Text="Stock mínimo" Style="{StaticResource Etiqueta}" />
                            <Entry Text="{Binding Actual.StockMinimo}" Keyboard="Numeric" Style="{StaticResource Campo}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Use punto (.) para decimales. Ej: 1.50" Style="{StaticResource TextoDetalle}" FontSize="11" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button Text="{Binding TextoBotonGuardar}" Command="{Binding GuardarCommand}" Style="{StaticResource BotonPrimario}" />
                        <Button Grid.Column="1" Text="🧹 Limpiar" Command="{Binding NuevoCommand}" Style="{StaticResource BotonSecundario}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- LISTADO -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Inventario" Style="{StaticResource TituloSeccion}" />
                <Label Grid.Column="1" Text="{Binding TotalRegistros, StringFormat='{0} material(es)'}"
                       Style="{StaticResource TextoDetalle}" VerticalOptions="Center" />
            </Grid>

            <SearchBar Text="{Binding Busqueda}" Placeholder="Buscar por nombre o categoría"
                       Style="{StaticResource BuscadorEstilo}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Acento}" />

            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.EmptyView>
                    <Label Text="No hay materiales para mostrar." Style="{StaticResource TextoDetalle}"
                           HorizontalTextAlignment="Center" Margin="0,20" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Material">
                        <Border Style="{StaticResource Tarjeta}" Padding="14">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding StockBajo}" Value="True">
                                    <Setter Property="Stroke" Value="#F59E0B" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Nombre}" Style="{StaticResource TextoItem}" />
                                    <Label Text="{Binding Resumen}" Style="{StaticResource TextoDetalle}" />
                                    <Label Text="{Binding Detalle}" Style="{StaticResource TextoDetalle}" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Button Text="✏️" Style="{StaticResource BotonIcono}"
                                            Command="{Binding EditarCommand, Source={RelativeSource AncestorType={x:Type vm:MaterialesViewModel}}, x:DataType=vm:MaterialesViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="🗑️" Style="{StaticResource BotonIcono}" BackgroundColor="{StaticResource Peligro}"
                                            Command="{Binding EliminarCommand, Source={RelativeSource AncestorType={x:Type vm:MaterialesViewModel}}, x:DataType=vm:MaterialesViewModel}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

