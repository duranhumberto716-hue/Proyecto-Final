<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Proyecto_Final.ViewModels"
             xmlns:models="clr-namespace:Proyecto_Final.Models"
             x:Class="Proyecto_Final.Views.ProveedoresPage"
             x:DataType="vm:ProveedoresViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource FondoApp}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- FORMULARIO (Crear / Editar) -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding TituloFormulario}" Style="{StaticResource TituloSeccion}" />

                    <Label Text="Empresa *" Style="{StaticResource Etiqueta}" />
                    <Entry Text="{Binding Actual.Empresa}" Placeholder="Ej: Cementos del Oriente" Style="{StaticResource Campo}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="NIT *" Style="{StaticResource Etiqueta}" />
                            <Entry Text="{Binding Actual.Nit}" Placeholder="Ej: 1020304050" Keyboard="Numeric"
                                   MaxLength="15" Style="{StaticResource Campo}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Teléfono *" Style="{StaticResource Etiqueta}" />
                            <Entry Text="{Binding Actual.Telefono}" Placeholder="Ej: 33521100" Keyboard="Telephone"
                                   MaxLength="8" Style="{StaticResource Campo}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Persona de contacto" Style="{StaticResource Etiqueta}" />
                    <Entry Text="{Binding Actual.Contacto}" Placeholder="Ej: Roberto Áñez" Style="{StaticResource Campo}" />

                    <Grid ColumnDefinitions="2*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Rubro *" Style="{StaticResource Etiqueta}" />
                            <Picker ItemsSource="{Binding Rubros}" SelectedItem="{Binding Actual.Rubro}"
                                    Title="Seleccione" Style="{StaticResource Selector}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Calificación *" Style="{StaticResource Etiqueta}" />
                            <Picker ItemsSource="{Binding Calificaciones}" SelectedItem="{Binding Actual.Calificacion}"
                                    Title="1 a 5" Style="{StaticResource Selector}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Correo electrónico (opcional)" Style="{StaticResource Etiqueta}" />
                    <Entry Text="{Binding Actual.Correo}" Placeholder="Ej: ventas@empresa.bo" Keyboard="Email"
                           Style="{StaticResource Campo}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button Text="{Binding TextoBotonGuardar}" Command="{Binding GuardarCommand}" Style="{StaticResource BotonPrimario}" />
                        <Button Grid.Column="1" Text="🧹 Limpiar" Command="{Binding NuevoCommand}" Style="{StaticResource BotonSecundario}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- LISTADO -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Proveedores registrados" Style="{StaticResource TituloSeccion}" />
                <Label Grid.Column="1" Text="{Binding TotalRegistros, StringFormat='{0} proveedor(es)'}"
                       Style="{StaticResource TextoDetalle}" VerticalOptions="Center" />
            </Grid>

            <SearchBar Text="{Binding Busqueda}" Placeholder="Buscar por empresa, NIT o rubro"
                       Style="{StaticResource BuscadorEstilo}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Acento}" />

            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.EmptyView>
                    <Label Text="No hay proveedores para mostrar." Style="{StaticResource TextoDetalle}"
                           HorizontalTextAlignment="Center" Margin="0,20" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Proveedor">
                        <Border Style="{StaticResource Tarjeta}" Padding="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Empresa}" Style="{StaticResource TextoItem}" />
                                    <Label Text="{Binding Resumen}" Style="{StaticResource TextoDetalle}" />
                                    <Label Text="{Binding Detalle}" Style="{StaticResource TextoDetalle}" TextColor="{StaticResource Acento}" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Button Text="✏️" Style="{StaticResource BotonIcono}"
                                            Command="{Binding EditarCommand, Source={RelativeSource AncestorType={x:Type vm:ProveedoresViewModel}}, x:DataType=vm:ProveedoresViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="🗑️" Style="{StaticResource BotonIcono}" BackgroundColor="{StaticResource Peligro}"
                                            Command="{Binding EliminarCommand, Source={RelativeSource AncestorType={x:Type vm:ProveedoresViewModel}}, x:DataType=vm:ProveedoresViewModel}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

