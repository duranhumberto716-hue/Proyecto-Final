<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Proyecto_Final.ViewModels"
             x:Class="Proyecto_Final.Views.RegistroPage"
             x:DataType="vm:RegistroViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource FondoApp}">

    <ScrollView>
        <VerticalStackLayout Padding="24,24" Spacing="18" MaximumWidthRequest="440">

            <VerticalStackLayout Spacing="6">
                <Border BackgroundColor="{StaticResource FondoTarjetaSuave}" StrokeShape="RoundRectangle 8"
                        StrokeThickness="0" Padding="10,4" HorizontalOptions="Start">
                    <Label Text="CUENTA DE CLIENTE" FontSize="10" FontAttributes="Bold"
                           TextColor="{StaticResource Acento}" CharacterSpacing="0.8" />
                </Border>
                <Label Text="Crea tu cuenta gratuita" FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource TextoClaro}" />
                <Label Text="Explora nuestras obras realizadas y solicita cotizaciones personalizadas por WhatsApp."
                       Style="{StaticResource TextoDetalle}" FontSize="13" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Tarjeta}" Padding="20">
                <VerticalStackLayout Spacing="12">

                    <!-- Error inline -->
                    <Border IsVisible="{Binding HayError}" BackgroundColor="#3B1117"
                            Stroke="{StaticResource BrochaPeligro}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 10" Padding="12,10">
                        <Label Text="{Binding MensajeError}" FontSize="12" TextColor="#FCA5A5" />
                    </Border>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nombre completo *" Style="{StaticResource Etiqueta}" />
                        <Border Style="{StaticResource CajaCampo}">
                            <Entry Text="{Binding NombreCompleto}" Placeholder="Ej: Juan Pérez"
                                   Style="{StaticResource CampoSinFondo}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nombre de usuario *" Style="{StaticResource Etiqueta}" />
                        <Border Style="{StaticResource CajaCampo}">
                            <Entry Text="{Binding Usuario}" Placeholder="Mínimo 4 caracteres (sin espacios)"
                                   Style="{StaticResource CampoSinFondo}" IsSpellCheckEnabled="False" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Contraseña *" Style="{StaticResource Etiqueta}" />
                        <Border Style="{StaticResource CajaCampo}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Entry Text="{Binding Contrasena}" Placeholder="Mínimo 6 caracteres"
                                       IsPassword="{Binding OcultarContrasena}" Style="{StaticResource CampoSinFondo}" />
                                <Button Grid.Column="1" Text="{Binding TextoVerContrasena}"
                                        Command="{Binding AlternarContrasenaCommand}"
                                        BackgroundColor="Transparent" TextColor="{StaticResource Acento}"
                                        FontSize="12" FontAttributes="Bold" Padding="6,0" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Confirmar contraseña *" Style="{StaticResource Etiqueta}" />
                        <Border Style="{StaticResource CajaCampo}">
                            <Entry Text="{Binding Confirmacion}" Placeholder="Repite tu contraseña"
                                   IsPassword="{Binding OcultarContrasena}" Style="{StaticResource CampoSinFondo}" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Crear mi cuenta" Command="{Binding RegistrarCommand}"
                            Style="{StaticResource BotonPrimario}" Margin="0,8,0,0" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Acento}" />
                    <Button Text="Ya tengo cuenta • Volver" Command="{Binding VolverCommand}"
                            Style="{StaticResource BotonSecundario}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Las cuentas registradas desde esta pantalla obtienen el perfil Cliente (solo catálogo y cotizaciones)."
                   Style="{StaticResource TextoDetalle}" FontSize="11" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
