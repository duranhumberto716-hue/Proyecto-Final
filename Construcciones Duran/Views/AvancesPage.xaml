<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Proyecto_Final.ViewModels"
             xmlns:models="clr-namespace:Proyecto_Final.Models"
             x:Class="Proyecto_Final.Views.AvancesPage"
             x:Name="Pagina"
             x:DataType="vm:AvancesViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource FondoApp}">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,36" Spacing="16" MaximumWidthRequest="1160">

            <!-- ENCABEZADO MINIMALISTA -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="3">
                    <Label Text="GESTIÓN DE DATOS • INTEGRANTE 4" Style="{StaticResource SubtituloSeccion}" />
                    <Label Text="CRUD de Avances" Style="{StaticResource TituloPagina}" />
                    <Label Text="{Binding TotalRegistros, StringFormat='Base de datos SQLite • {0} registro(s)'}"
                           Style="{StaticResource TextoDetalle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Ver reporte" Command="{Binding VerReporteCommand}"
                        Style="{StaticResource BotonAccion}" VerticalOptions="Center" />
            </Grid>

            <BoxView HeightRequest="1" Color="{StaticResource BordeTarjeta}" Opacity="0.6" />

            <!-- FORMULARIO DESPLEGABLE UNIFICADO (Agregar / Editar) -->
            <Border Style="{StaticResource Tarjeta}" Stroke="{StaticResource BrochaAcento}" StrokeThickness="1.5"
                    MaximumWidthRequest="760" IsVisible="{Binding FormularioVisible}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding TituloFormulario}" Style="{StaticResource TituloSeccion}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Obra *" Style="{StaticResource Etiqueta}" />
                            <Border Style="{StaticResource CajaCampo}">
                                <Picker ItemsSource="{Binding ObrasDisponibles}" SelectedItem="{Binding Actual.NombreObra}"
                                        Title="Seleccione una obra" Style="{StaticResource SelectorSinFondo}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Etapa constructiva *" Style="{StaticResource Etiqueta}" />
                            <Border Style="{StaticResource CajaCampo}">
                                <Picker ItemsSource="{Binding Etapas}" SelectedItem="{Binding Actual.Etapa}"
                                        Title="Seleccione la etapa" Style="{StaticResource SelectorSinFondo}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Porcentaje de avance (0 - 100) *" Style="{StaticResource Etiqueta}" />
                            <Border Style="{StaticResource CajaCampo}">
                                <Entry Text="{Binding Actual.Porcentaje}" Keyboard="Numeric" Placeholder="Ej: 65"
                                       Style="{StaticResource CampoSinFondo}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Fecha *" Style="{StaticResource Etiqueta}" />
                            <Border Style="{StaticResource CajaCampo}">
                                <DatePicker Date="{Binding Actual.Fecha}" MaximumDate="{Binding FechaMaxima}"
                                            Style="{StaticResource SelectorFechaSinFondo}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Responsable / Supervisor *" Style="{StaticResource Etiqueta}" />
                        <Border Style="{StaticResource CajaCampo}">
                            <Entry Text="{Binding Actual.Responsable}" Placeholder="Ej: Ing. Carlos Durán"
                                   Style="{StaticResource CampoSinFondo}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Observaciones técnicas" Style="{StaticResource Etiqueta}" />
                        <Border Style="{StaticResource CajaCampo}">
                            <Entry Text="{Binding Actual.Observaciones}" Placeholder="Detalle de trabajos ejecutados"
                                   Style="{StaticResource CampoSinFondo}" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                        <Button Text="{Binding TextoBotonGuardar}" Command="{Binding GuardarCommand}" Style="{StaticResource BotonPrimario}" />
                        <Button Grid.Column="1" Text="Cancelar" Command="{Binding CancelarCommand}" Style="{StaticResource BotonSecundario}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- BUSCADOR MINIMALISTA -->
            <Border Style="{StaticResource CajaCampo}" MaximumWidthRequest="460" HorizontalOptions="Start">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Path Data="M15.5,14 H14.71 L14.43,13.73 C15.41,12.59 16,11.11 16,9.5 C16,5.91 13.09,3 9.5,3 C5.91,3 3,5.91 3,9.5 C3,13.09 5.91,16 9.5,16 C11.11,16 12.59,15.41 13.73,14.43 L14,14.71 V15.5 L19,20.49 L20.49,19 L15.5,14 Z M9.5,14 C7.01,14 5,11.99 5,9.5 C5,7.01 7.01,5 9.5,5 C11.99,5 14,7.01 14,9.5 C14,11.99 11.99,14 9.5,14 Z"
                          Fill="{StaticResource TextoSecundario}" WidthRequest="18" HeightRequest="18"
                          Aspect="Uniform" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Text="{Binding Busqueda}"
                           Placeholder="Buscar por obra, etapa o responsable..."
                           Style="{StaticResource CampoSinFondo}" />
                </Grid>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Acento}" />

            <!-- TABLA CRUD -->
            <Border Style="{StaticResource ContenedorTabla}">
                <ScrollView Orientation="Horizontal">
                    <VerticalStackLayout Spacing="0">
                        <Grid BackgroundColor="{StaticResource FondoEncabezadoTabla}"
                              Padding="14,12" ColumnSpacing="12"
                              ColumnDefinitions="45,190,175,115,155,90,195,145">
                            <Label Grid.Column="0" Text="ID" Style="{StaticResource EncabezadoTabla}" />
                            <Label Grid.Column="1" Text="Obra" Style="{StaticResource EncabezadoTabla}" />
                            <Label Grid.Column="2" Text="Etapa" Style="{StaticResource EncabezadoTabla}" />
                            <Label Grid.Column="3" Text="Avance" Style="{StaticResource EncabezadoTabla}" />
                            <Label Grid.Column="4" Text="Responsable" Style="{StaticResource EncabezadoTabla}" />
                            <Label Grid.Column="5" Text="Fecha" Style="{StaticResource EncabezadoTabla}" />
                            <Label Grid.Column="6" Text="Observaciones" Style="{StaticResource EncabezadoTabla}" />
                            <Label Grid.Column="7" Text="Acciones" Style="{StaticResource EncabezadoTabla}" />
                        </Grid>
                        <BoxView HeightRequest="1.5" Color="{StaticResource Acento}" />

                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Items}">
                            <BindableLayout.EmptyView>
                                <Label Text="No hay avances registrados para mostrar." Style="{StaticResource TextoDetalle}"
                                       Padding="16,24" HorizontalTextAlignment="Start" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Avance">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid Padding="14,10" ColumnSpacing="12"
                                              BackgroundColor="{StaticResource FondoTarjeta}"
                                              ColumnDefinitions="45,190,175,115,155,90,195,145">
                                            <Grid.Triggers>
                                                <DataTrigger TargetType="Grid" Binding="{Binding EsFilaAlterna}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource FondoFilaAlterna}" />
                                                </DataTrigger>
                                            </Grid.Triggers>

                                            <Label Grid.Column="0" Text="{Binding Id}" Style="{StaticResource CeldaId}" />
                                            <Label Grid.Column="1" Text="{Binding NombreObra}" Style="{StaticResource CeldaTexto}" FontAttributes="Bold" />
                                            <Label Grid.Column="2" Text="{Binding Etapa}" Style="{StaticResource CeldaSecundaria}" />
                                            <VerticalStackLayout Grid.Column="3" Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding PorcentajeTexto}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Acento}" />
                                                <ProgressBar Progress="{Binding ProgresoNormalizado}" ProgressColor="{StaticResource Acento}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="4" Text="{Binding Responsable}" Style="{StaticResource CeldaSecundaria}" />
                                            <Label Grid.Column="5" Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" Style="{StaticResource CeldaSecundaria}" />
                                            <Label Grid.Column="6" Text="{Binding Observaciones}" Style="{StaticResource CeldaSecundaria}" />
                                            <HorizontalStackLayout Grid.Column="7" Spacing="6" VerticalOptions="Center">
                                                <Button Text="Editar" Style="{StaticResource BotonEditarTabla}"
                                                        Command="{Binding Source={x:Reference Pagina}, Path=BindingContext.EditarCommand, x:DataType={x:Null}}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Text="Borrar" Style="{StaticResource BotonEliminarTabla}"
                                                        Command="{Binding Source={x:Reference Pagina}, Path=BindingContext.EliminarCommand, x:DataType={x:Null}}"
                                                        CommandParameter="{Binding .}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{StaticResource BordeTarjeta}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- BARRA INFERIOR DE ACCIONES -->
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center">
                <Button Text="Exportar CSV" Command="{Binding ExportarCsvCommand}"
                        Style="{StaticResource BotonCsv}" Margin="0,0,10,8" />
                <Button Text="Agregar Avance" Command="{Binding NuevoCommand}"
                        Style="{StaticResource BotonAgregar}" Margin="0,0,10,8" />
            </FlexLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
