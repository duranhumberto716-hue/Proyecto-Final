<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Proyecto_Final.ViewModels"
             xmlns:models="clr-namespace:Proyecto_Final.Models"
             x:Class="Proyecto_Final.Views.EmpleadosPage"
             x:DataType="vm:EmpleadosViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource FondoApp}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- FORMULARIO (Crear / Editar) -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding TituloFormulario}" Style="{StaticResource TituloSeccion}" />

                    <Label Text="Nombre completo *" Style="{StaticResource Etiqueta}" />
                    <Entry Text="{Binding Actual.NombreCompleto}" Placeholder="Ej: Luis Gutiérrez" Style="{StaticResource Campo}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="CI *" Style="{StaticResource Etiqueta}" />
                            <Entry Text="{Binding Actual.Ci}" Placeholder="Ej: 5678912" Style="{StaticResource Campo}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Teléfono" Style="{StaticResource Etiqueta}" />
                            <Entry Text="{Binding Actual.Telefono}" Placeholder="Ej: 70011223" Keyboard="Telephone"
                                   MaxLength="8" Style="{StaticResource Campo}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Cargo *" Style="{StaticResource Etiqueta}" />
                            <Picker ItemsSource="{Binding Cargos}" SelectedItem="{Binding Actual.Cargo}"
                                    Title="Seleccione" Style="{StaticResource Selector}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Salario mensual (Bs) *" Style="{StaticResource Etiqueta}" />
                            <Entry Text="{Binding Actual.SalarioMensual}" Keyboard="Numeric" Style="{StaticResource Campo}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Fecha de ingreso *" Style="{StaticResource Etiqueta}" />
                            <DatePicker Date="{Binding Actual.FechaIngreso}" MaximumDate="{Binding FechaMaxima}"
                                        Style="{StaticResource SelectorFecha}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Activo" Style="{StaticResource Etiqueta}" />
                            <Switch IsToggled="{Binding Actual.Activo}" OnColor="{StaticResource Acento}" ThumbColor="White" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button Text="{Binding TextoBotonGuardar}" Command="{Binding GuardarCommand}" Style="{StaticResource BotonPrimario}" />
                        <Button Grid.Column="1" Text="🧹 Limpiar" Command="{Binding NuevoCommand}" Style="{StaticResource BotonSecundario}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- LISTADO -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Personal registrado" Style="{StaticResource TituloSeccion}" />
                <Label Grid.Column="1" Text="{Binding TotalRegistros, StringFormat='{0} empleado(s)'}"
                       Style="{StaticResource TextoDetalle}" VerticalOptions="Center" />
            </Grid>

            <SearchBar Text="{Binding Busqueda}" Placeholder="Buscar por nombre, CI o cargo"
                       Style="{StaticResource BuscadorEstilo}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Acento}" />

            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.EmptyView>
                    <Label Text="No hay empleados para mostrar." Style="{StaticResource TextoDetalle}"
                           HorizontalTextAlignment="Center" Margin="0,20" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Empleado">
                        <Border Style="{StaticResource Tarjeta}" Padding="14">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Activo}" Value="False">
                                    <Setter Property="Opacity" Value="0.6" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding NombreCompleto}" Style="{StaticResource TextoItem}" />
                                    <Label Text="{Binding Resumen}" Style="{StaticResource TextoDetalle}" />
                                    <Label Text="{Binding Detalle}" Style="{StaticResource TextoDetalle}" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Button Text="✏️" Style="{StaticResource BotonIcono}"
                                            Command="{Binding EditarCommand, Source={RelativeSource AncestorType={x:Type vm:EmpleadosViewModel}}, x:DataType=vm:EmpleadosViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="🗑️" Style="{StaticResource BotonIcono}" BackgroundColor="{StaticResource Peligro}"
                                            Command="{Binding EliminarCommand, Source={RelativeSource AncestorType={x:Type vm:EmpleadosViewModel}}, x:DataType=vm:EmpleadosViewModel}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

