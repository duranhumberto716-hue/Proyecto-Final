<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proyecto_Final.Views.OdsPage"
             Title="ODS y acerca del proyecto"
             BackgroundColor="{StaticResource FondoApp}">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,36" Spacing="18" MaximumWidthRequest="1000">

            <VerticalStackLayout Spacing="3">
                <Label Text="PROYECTO SOCIOFORMATIVO" Style="{StaticResource SubtituloSeccion}" />
                <Label Text="Construcciones Durán y ODS" Style="{StaticResource TituloPagina}" />
                <Label Text="Alineación con los Objetivos de Desarrollo Sostenible (pactomundial.org) y ejes educativos."
                       Style="{StaticResource TextoDetalle}" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{StaticResource BordeTarjeta}" Opacity="0.6" />

            <!-- Empresa -->
            <Border Style="{StaticResource TarjetaMinimal}" Stroke="{StaticResource BrochaAcento}" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="EMPRENDIMIENTO" Style="{StaticResource SubtituloSeccion}" />
                    <Label Style="{StaticResource TextoDetalle}" FontSize="13" TextColor="{StaticResource TextoSuave}"
                           Text="Emprendimiento de Santa Cruz de la Sierra, Bolivia, dedicado a la construcción residencial, obra gruesa, remodelaciones y acabados. La app digitaliza la gestión de obras, personal, materiales y avances, además de ofrecer cotización directa por WhatsApp." />
                    <Label Text="Teléfono: 77661522  •  Santa Cruz de la Sierra, Bolivia" Style="{StaticResource TextoDetalle}" />
                </VerticalStackLayout>
            </Border>

            <!-- ODS -->
            <Label Text="OBJETIVOS DE DESARROLLO SOSTENIBLE" Style="{StaticResource SubtituloSeccion}" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TarjetaMinimal}">
                    <VerticalStackLayout Spacing="8">
                        <Border BackgroundColor="#A21942" StrokeShape="RoundRectangle 8" StrokeThickness="0"
                                Padding="10,4" HorizontalOptions="Start">
                            <Label Text="ODS 8" FontSize="11" FontAttributes="Bold" TextColor="White" />
                        </Border>
                        <Label Text="Trabajo decente y crecimiento económico" Style="{StaticResource TextoItem}" FontSize="14" />
                        <Label Style="{StaticResource TextoDetalle}"
                               Text="Control de personal con salarios iguales o mayores al mínimo nacional y planillas ordenadas." />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource TarjetaMinimal}">
                    <VerticalStackLayout Spacing="8">
                        <Border BackgroundColor="#FD6925" StrokeShape="RoundRectangle 8" StrokeThickness="0"
                                Padding="10,4" HorizontalOptions="Start">
                            <Label Text="ODS 9" FontSize="11" FontAttributes="Bold" TextColor="White" />
                        </Border>
                        <Label Text="Industria, innovación e infraestructura" Style="{StaticResource TextoItem}" FontSize="14" />
                        <Label Style="{StaticResource TextoDetalle}"
                               Text="Incorporación de .NET MAUI, SQLite y APIs externas en la gestión de obras civiles." />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource TarjetaMinimal}">
                    <VerticalStackLayout Spacing="8">
                        <Border BackgroundColor="#FD9D24" StrokeShape="RoundRectangle 8" StrokeThickness="0"
                                Padding="10,4" HorizontalOptions="Start">
                            <Label Text="ODS 11" FontSize="11" FontAttributes="Bold" TextColor="White" />
                        </Border>
                        <Label Text="Ciudades y comunidades sostenibles" Style="{StaticResource TextoItem}" FontSize="14" />
                        <Label Style="{StaticResource TextoDetalle}"
                               Text="Planificación y seguimiento de viviendas y obras seguras mediante control de avances." />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TarjetaMinimal}">
                    <VerticalStackLayout Spacing="8">
                        <Border BackgroundColor="#BF8B2E" StrokeShape="RoundRectangle 8" StrokeThickness="0"
                                Padding="10,4" HorizontalOptions="Start">
                            <Label Text="ODS 12" FontSize="11" FontAttributes="Bold" TextColor="White" />
                        </Border>
                        <Label Text="Producción y consumo responsables" Style="{StaticResource TextoItem}" FontSize="14" />
                        <Label Style="{StaticResource TextoDetalle}"
                               Text="Alertas de stock mínimo y control de inventario para evitar desperdicios en obra." />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Ejes y equipo -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource TarjetaMinimal}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="EJES DEL MODELO EDUCATIVO" Style="{StaticResource SubtituloSeccion}" />
                        <Label Style="{StaticResource TextoDetalle}" Text="• Emprendedurismo responsable" />
                        <Label Style="{StaticResource TextoDetalle}" Text="• Ética y ciudadanía global (APA 7)" />
                        <Label Style="{StaticResource TextoDetalle}" Text="• Tecnologías emergentes (MAUI, SQLite, APIs)" />
                        <Label Style="{StaticResource TextoDetalle}" Text="• Investigación y pensamiento crítico" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource TarjetaMinimal}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="EQUIPO DE DESARROLLO" Style="{StaticResource SubtituloSeccion}" />
                        <Label Style="{StaticResource TextoDetalle}" Text="Integrante 1 • Obras" />
                        <Label Style="{StaticResource TextoDetalle}" Text="Integrante 2 • Personal" />
                        <Label Style="{StaticResource TextoDetalle}" Text="Integrante 3 • Materiales" />
                        <Label Style="{StaticResource TextoDetalle}" Text="Integrante 4 • Avances" />
                        <Label Style="{StaticResource TextoDetalle}" FontSize="11" Margin="0,4,0,0"
                               Text="Aplicaciones Móviles I • II/2026" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
