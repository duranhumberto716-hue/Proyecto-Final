<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Proyecto_Final.ViewModels"
             xmlns:models="clr-namespace:Proyecto_Final.Models"
             x:Class="Proyecto_Final.Views.ReportePage"
             x:DataType="vm:ReporteViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource FondoApp}">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,36" Spacing="18" MaximumWidthRequest="1000">

            <!-- ENCABEZADO MINIMALISTA -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="3">
                    <Label Text="FORMULARIO DE INFORMACIÓN" Style="{StaticResource SubtituloSeccion}" />
                    <Label Text="{Binding Title}" Style="{StaticResource TituloPagina}" />
                    <Label Text="{Binding Descripcion}" Style="{StaticResource TextoDetalle}" />
                    <Label Text="{Binding FechaGeneracion}" Style="{StaticResource TextoDetalle}" FontSize="11" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Actualizar" Command="{Binding ActualizarCommand}"
                        Style="{StaticResource BotonAccion}" VerticalOptions="Center" />
            </Grid>

            <BoxView HeightRequest="1" Color="{StaticResource BordeTarjeta}" Opacity="0.6" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Acento}" />

            <!-- INDICADORES KPI -->
            <FlexLayout BindableLayout.ItemsSource="{Binding Indicadores}" Wrap="Wrap"
                        JustifyContent="SpaceBetween" AlignItems="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Indicador">
                        <Border Style="{StaticResource TarjetaMinimal}" Padding="14" Margin="0,0,0,10"
                                FlexLayout.Basis="48.5%">
                            <VerticalStackLayout Spacing="5">
                                <Border BackgroundColor="{StaticResource FondoTarjetaSuave}" StrokeShape="RoundRectangle 6"
                                        StrokeThickness="0" Padding="7,2" HorizontalOptions="Start">
                                    <Label Text="{Binding Etiqueta}" FontSize="9" FontAttributes="Bold"
                                           TextColor="{StaticResource Acento}" CharacterSpacing="0.8" />
                                </Border>
                                <Label Text="{Binding Valor}" FontSize="19" FontAttributes="Bold"
                                       TextColor="{StaticResource TextoClaro}" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Titulo}" Style="{StaticResource TextoDetalle}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- DETALLE -->
            <Label Text="{Binding TituloLista}" Style="{StaticResource TituloSeccion}" />

            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Filas}">
                <BindableLayout.EmptyView>
                    <Label Text="No hay datos registrados todavía." Style="{StaticResource TextoDetalle}"
                           HorizontalTextAlignment="Center" Margin="0,20" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:FilaReporte">
                        <Border Style="{StaticResource TarjetaMinimal}" Padding="14">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Destacado}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource BrochaAlerta}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Titulo}" Style="{StaticResource TextoItem}" FontSize="14" />
                                    <Label Text="{Binding Detalle}" Style="{StaticResource TextoDetalle}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding Valor}" FontAttributes="Bold" FontSize="14"
                                       TextColor="{StaticResource Acento}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="{Binding NotaPie}" Style="{StaticResource TextoDetalle}" FontAttributes="Italic"
                   HorizontalTextAlignment="Center" Margin="0,4,0,12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
